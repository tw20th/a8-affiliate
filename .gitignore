# ==================================================
# OS / エディタ
# ==================================================
.DS_Store
Thumbs.db
.idea/

.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json


# ==================================================
# Node / パッケージマネージャ
# ==================================================
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log


# ==================================================
# TypeScript
# ==================================================
**/*.tsbuildinfo


# ==================================================
# 環境変数 / 秘密鍵（最重要）
# ==================================================
.env
.env.*
!.env.example

apps/web/.env.local
firebase/functions/.env

*.pem
*.p12
*.key
*.crt
*.der
*.keystore

serviceAccount*.json
firebase/functions/gsc_sa.json

*.secret.*
*.secret.json

firebase/functions/secrets/


# ==================================================
# Next.js
# ==================================================
.next/
.vercel/

# 通常の export out は無視
/out/

# ただし app router 配下の out は許可
!.apps/web/app/out/


# ==================================================
# Firebase
# ==================================================
.firebase/
firebase/functions/.runtimeconfig.json

**/firestore-debug.log
**/*-debug.log


# ==================================================
# ビルド生成物
# ==================================================
**/dist/
firebase/functions/lib/
firebase/functions/dist/
packages/**/dist/

# ※ src/** は push する前提


# ==================================================
# カバレッジ / 一時ファイル
# ==================================================
coverage/
.nyc_output/
inv_*.json


# ==================================================
# pnpm / ローカルキャッシュ
# ==================================================
.pnpm-store/


# ==================================================
# Functions ローカル生成物・共有物
# ==================================================
firebase/functions/shared-types/
firebase/functions/packages/


# ==================================================
# Turborepo / キャッシュ
# ==================================================
.turbo/
apps/**/.turbo/
apps/**/.next/cache/
